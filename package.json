{
  "name": "thirdrailify-lab",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler pages dev dist",
    "typecheck": "node scripts/source-check.mjs typecheck",
    "lint": "node scripts/source-check.mjs lint",
    "test": "node --test tests/*.test.mjs",
    "test:poc": "node --test poc/tests/*.test.mjs"
  },
  "devDependencies": { "wrangler": "4.60.0" }
}
