# Local POC configuration. Your existing .env is NOT included in update archives.
# Paste provider-issued API keys privately here or use Connections in the app.
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
XAI_API_KEY=

# Optional saved selections. Leave blank: the UI loads actual provider catalogues.
OPENAI_IMAGE_MODEL=
OPENAI_CHAT_MODEL=
XAI_IMAGE_MODEL=
XAI_CHAT_MODEL=

# Optional only; status polling works without a webhook.
REPLICATE_WEBHOOK_SIGNING_SECRET=
PORT=4317


GOOGLE_PSE_CX=
PEXELS_API_KEY=
PIXABAY_API_KEY=

UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
